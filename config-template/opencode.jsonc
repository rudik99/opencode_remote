{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "lsp": {
    "typescript": {
      "command": ["tsc", "--lsp", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  },
  "instructions": [
    "/home/opencode/.config/opencode/instructions/visual-verification.md",
    "/home/opencode/.config/opencode/instructions/pr-follow-through.md",
    "/home/opencode/.config/opencode/instructions/execution-efficiency.md",
    "/home/opencode/.config/opencode/instructions/stream-isolation.md",
    "/home/opencode/.config/opencode/instructions/memory-curation.md"
  ],
  "plugin": [
    "file:///home/opencode/.config/opencode/ponytail/.opencode/plugins/ponytail.mjs",
    "file:///home/opencode/.config/opencode/node_modules/@whisperopencode/push/dist/src/index.js"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--cdp-endpoint",
        "ws://chromium:3000",
        "--image-responses",
        "allow",
        "--output-dir",
        "/workspace/screenshots",
        "--output-max-size",
        "524288000"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "perplexity": {
      "type": "local",
      "command": ["npx", "-y", "perplexity-mcp@0.2.3"],
      "enabled": false,
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking@2026.7.4"],
      "enabled": false
    },
    "railway": {
      "type": "local",
      "command": ["npx", "-y", "@railway/mcp-server@0.1.12"],
      "enabled": false,
      "environment": {
        "RAILWAY_TOKEN": "{env:RAILWAY_TOKEN}"
      }
    },
    "v0": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote@0.8.1",
        "https://mcp.v0.dev",
        "--header",
        "Authorization: Bearer {env:V0_API_KEY}"
      ],
      "enabled": false
    }
  },
  "tools": {
    "context7*": true,
    "github*": false,
    "perplexity*": false,
    "playwright*": true,
    "railway*": false,
    "sequential-thinking*": false,
    "v0*": false
  },
  "permission": {
    "claude_code": "ask"
  }
}
