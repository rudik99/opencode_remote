COMPOSE_PROJECT_NAME=opencode-remote

# Match the host user on Linux so bind-mounted files remain writable.
OPENCODE_UID=1000
OPENCODE_GID=1000
OPENCODE_VERSION=latest
CLAUDE_CODE_VERSION=latest
SALESFORCE_CLI_VERSION=2.149.9
OPENCODE_TAG=latest
OPENCODE_MODEL=anthropic/claude-sonnet-4-6
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password

# Configure the provider required by OPENCODE_MODEL.
ANTHROPIC_API_KEY=

# Optional Claude Pro/Max delegation through the official Claude Code CLI.
# Generate privately with: docker compose exec opencode claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional integrations.
GITHUB_TOKEN=
CONTEXT7_API_KEY=

# Wildcard previews become <project>.<domain>.
PREVIEW_BASE_DOMAIN=example.com

# Token for a remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Resource limits for the outer services.
OPENCODE_MEMORY_LIMIT=4g
OPENCODE_CPU_LIMIT=4
DIND_MEMORY_LIMIT=8g
DIND_CPU_LIMIT=4

# Change this private subnet if it overlaps an existing Docker or LAN network.
OPENCODE_NETWORK_SUBNET=10.77.77.0/24
